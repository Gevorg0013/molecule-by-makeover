# Copy to .env and fill in real values before running docker compose up.

# --- PostgreSQL ---
POSTGRES_DB=molecule_by_makeover
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# JWT - SigningKey must be a long random string (32+ chars) in production.
JWT_ISSUER=MoleculeByMakeover
JWT_AUDIENCE=MoleculeByMakeoverClient
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- SMTP (leave Host empty to disable outbound email in dev) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@moleculebymakeover.com

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_PORT=5173
# Browser-facing API URL baked into the frontend build (must include /api/v1).
VITE_API_BASE_URL=http://localhost:8080/api/v1
