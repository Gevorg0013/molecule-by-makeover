{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=molecule_by_makeover;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "MoleculeByMakeover",
    "Audience": "MoleculeByMakeoverClient",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "FileStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads"
  },

  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromAddress": "no-reply@moleculebymakeover.com",
    "FromName": "Molecule by Makeover"
  },
  "Payments": {
    "Stripe": {
      "Enabled": true,
      "SecretKey": "",
      "PublishableKey": "",
      "WebhookSecret": "whsec_replace_me"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
