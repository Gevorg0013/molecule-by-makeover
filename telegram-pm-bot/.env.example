# From https://my.telegram.org/apps (see README) - your PERSONAL Telegram
# account's API credentials, NOT a bot token. No BotFather involved.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Anthropic API key - platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown) ---
# ALLOWED_CHAT_ID=me                     # 'me' = Saved Messages; or a numeric chat/user id to listen elsewhere
# SESSION_FILE=./data/telegram.session   # written by `npm run login`, loaded on every start
# DB_FILE=./data/pm.sqlite
# WORKING_DIR=..                         # repo root the agents operate on
# CLAUDE_MODEL=claude-opus-4-8
# PERMISSION_MODE=default                # tool permission decisions are actually made by canUseTool (see DECISIONS.md) - leave this alone
# MAX_TURNS_PER_AGENT_RUN=100
# MAX_BUDGET_USD_PER_AGENT_RUN=3
# MAX_ATTEMPTS_PER_TASK=3
